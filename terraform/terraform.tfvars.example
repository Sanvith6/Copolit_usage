# Copy this file to terraform.tfvars and fill in the required values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Additionally, export your AWS credentials as environment variables:
#   export AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
#   export AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"

# ──────────────────────────────────────────────
# AWS Region
# ──────────────────────────────────────────────
aws_region = "us-east-1"

# ──────────────────────────────────────────────
# Project Settings
# ──────────────────────────────────────────────
project_name = "my-aws-project"

# ──────────────────────────────────────────────
# VPC Settings
# ──────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

# ──────────────────────────────────────────────
# EC2 / Auto Scaling Settings
# ──────────────────────────────────────────────
instance_type        = "t3.micro"
ami_id               = "" # Leave empty to use latest Amazon Linux 2023
asg_min_size         = 1
asg_max_size         = 3
asg_desired_capacity = 2

# ──────────────────────────────────────────────
# RDS Settings
# ──────────────────────────────────────────────
db_instance_class = "db.t3.micro"
db_name           = "appdb"
db_username       = "admin"

# OPTIONAL — If left empty (or omitted), a secure 24-character random password
# is generated automatically. You can retrieve it after apply with:
#   terraform output -raw rds_password
# To set your own password instead, uncomment the line below:
# db_password = "YOUR_STRONG_PASSWORD"
